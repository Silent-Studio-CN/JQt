CompactTimeEdit:read-only,
SpinBox[symbolVisible=false],
DoubleSpinBox[symbolVisible=false],
DateEdit[symbolVisible=false],
DateTimeEdit[symbolVisible=false],
TimeEdit[symbolVisible=false],
