DateTimeEdit:hover,
TimeEdit:hover,
CompactSpinBox:hover,
CompactDoubleSpinBox:hover,
CompactDateEdit:hover,
CompactDateTimeEdit:hover,
CompactTimeEdit:hover {
    background-color: rgba(249, 249, 249, 0.5);
